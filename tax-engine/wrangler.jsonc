{
  "name": "tax-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // tax-watch: weekly poll of federal/state/local tax-law sources.
  // Search discovery runs through the provider below — swap SEARCH_PROVIDER
  // to brave/exa/perplexity/firecrawl after `wrangler secret put <NAME>_API_KEY`.
  // WATCH_SEARCH_ENABLED="0" disables discovery (poll-only mode).
  "triggers": { "crons": ["20 6 * * 1"] },
  "vars": {
    "SEARCH_PROVIDER": "duckduckgo",
    "WATCH_SEARCH_LIMIT": "5"
  },

  // --- Persistence (provisioned 2026-09-16) ------------------------------
  // D1 `tax-engine` + R2 `tax-engine-artifacts` exist in the account.
  // Schema changes: `wrangler d1 migrations apply DB --remote` (without
  // --remote it hits the local simulator — see repo AGENTS.md).
  // RETURNS_BUCKET serves /artifacts routes and stores POST /returns JSON
  // snapshots under returns/<id>.json. Reference docs live under state/
  // and geo/ prefixes (see state/*/manifest.json, geo/manifest.json).
  // For local dev: `wrangler d1 migrations apply DB --local`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tax-engine",
      "database_id": "be93127d-3edb-49a5-b01c-a7ee6368d744",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RETURNS_BUCKET", "bucket_name": "tax-engine-artifacts" }]
}
