{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prop-a-counterfactual",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    { "binding": "DOCS", "bucket_name": "prop-a-docs" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prop-a-db",
      "database_id": "REPLACE-ON-CREATE",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
